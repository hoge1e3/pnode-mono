{
    "compilerOptions": {
      // ソースマップを有効化
      "sourceMap": true,
      // TSはECMAScript 5に変換
      "target": "es2022",
      "lib": ["es2022","dom.iterable"],
      // TSのモジュールはES Modulesとして出力
      "module": "esnext",
      //"allowImportingTsExtensions": true,
      //"noEmit": true,
      "moduleResolution": "node",
      "allowSyntheticDefaultImports":true,
      "declaration": true,
      // 厳密モードとして設定
      "strict": true,
      "outDir":"./js",
      "incremental": true,
      "tsBuildInfoFile": "./.tsbuildinfo",
    },
    "include": ["src"]
  }
